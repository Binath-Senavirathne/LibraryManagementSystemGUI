<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="250.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AverageCostController">
   <children>
      <Label layoutX="416.0" layoutY="34.0" text="Average Book Cost" textFill="#171499">
         <font>
            <Font name="Arial Rounded MT Bold" size="18.0" />
         </font>
      </Label>
      <GridPane layoutX="300.0" layoutY="76.0" prefHeight="104.0" prefWidth="400.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints maxHeight="31.6" minHeight="10.0" prefHeight="28.4" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="42.4" minHeight="10.0" prefHeight="35.2" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="65.6" minHeight="10.0" prefHeight="21.6" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Total Books">
               <font><Font size="14.0" /></font>
            </Label>
            <Label text="Total Book Price" GridPane.rowIndex="1">
               <font><Font size="14.0" /></font>
            </Label>
            <Label text="Average Cost" GridPane.rowIndex="2">
               <font><Font size="14.0" /></font>
            </Label>
            <Label fx:id="lblTotalBooks" text="-" textAlignment="CENTER" GridPane.columnIndex="1">
               <font><Font size="14.0" /></font>
            </Label>
            <Label fx:id="lblTotalPrice" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <font><Font size="14.0" /></font>
            </Label>
            <Label fx:id="lblAverageCost" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <font><Font size="14.0" /></font>
            </Label>
         </children>
      </GridPane>
      <Button fx:id="btnCalculate" layoutX="425.0" layoutY="200.0" mnemonicParsing="false" style="-fx-background-color: #0f1a99;" text="Calculate Average Cost" textFill="WHITE">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
