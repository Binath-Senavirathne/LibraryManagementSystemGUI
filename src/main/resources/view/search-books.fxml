<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SearchBooksController">
   <children>
      <Label layoutX="319.0" layoutY="47.0" text="Search Books" textFill="#170886">
         <font>
            <Font name="Arial Rounded MT Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="43.0" layoutY="94.0" prefHeight="20.0" prefWidth="718.0" text="Search for books by title. Use a wildcard (*) at the end to match prefixes, e.g. 'The*' finds all titles starting with 'The'. ">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="43.0" layoutY="120.0" text="Results can be exported to a text file.">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <HBox layoutX="43.0" layoutY="151.0" prefHeight="35.0" prefWidth="571.0">
         <children>
            <Label prefHeight="37.0" prefWidth="93.0" text="Book Name : ">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <TextField fx:id="searchTextField" prefHeight="36.0" prefWidth="165.0" />
            <Button fx:id="searchButton" mnemonicParsing="false" prefHeight="39.0" prefWidth="58.0" style="-fx-background-color: #0f1a99;" text="Search" textFill="WHITE">
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Button>
            <Button fx:id="clearButton" mnemonicParsing="false" prefHeight="40.0" prefWidth="60.0" style="-fx-background-color: #817d7d;" text="Clear" textFill="WHITE">
               <HBox.margin>
                  <Insets left="20.0" right="20.0" />
               </HBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Button>
            <Button fx:id="exportButton" mnemonicParsing="false" prefHeight="38.0" prefWidth="66.0" style="-fx-background-color: #58a944;" text="Export" textFill="#f2f2f2">
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <TableView fx:id="searchResultsTableView" layoutX="43.0" layoutY="204.0" prefHeight="278.0" prefWidth="718.0">
        <columns>
          <TableColumn fx:id="bookIdColumn" prefWidth="75.0" text="Book_ID" />
          <TableColumn fx:id="titleColumn" prefWidth="225.60003662109375" text="Name" />
            <TableColumn fx:id="authorColumn" prefWidth="160.79998779296875" text="Author" />
            <TableColumn fx:id="isbnColumn" prefWidth="147.99993896484375" text="ISBN " />
            <TableColumn fx:id="availabilityColumn" prefWidth="109.5999755859375" text="Availability Count" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
