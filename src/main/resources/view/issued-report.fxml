<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="500.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.IssuedReportController">
   <children>
      <Label layoutX="409.0" layoutY="39.0" text="Books Issued Report" textAlignment="CENTER" textFill="#13289e">
         <font>
            <Font name="Arial Rounded MT Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="54.0" layoutY="76.0" text="Enter a date to search books issued on a date">
         <font>
            <Font name="Arial Rounded MT Bold" size="14.0" />
         </font>
      </Label>
      <HBox layoutX="208.0" layoutY="111.0" prefHeight="34.0" prefWidth="583.0">
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <children>
            <Label prefHeight="35.0" prefWidth="134.0" text="Date(DD/MM/YYYY)">
               <font>
                  <Font size="13.0" />
               </font>
            </Label>
            <TextField fx:id="dateTextField" prefHeight="34.0" prefWidth="190.0" promptText="eg : 27/04/2026" />
            <Button fx:id="generateReportButton" mnemonicParsing="false" prefHeight="35.0" prefWidth="124.0" style="-fx-background-color: #0f1a99;" text="Generate Report" textFill="WHITE">
               <HBox.margin>
                  <Insets left="50.0" />
               </HBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Button>
            <Button fx:id="clearButton" mnemonicParsing="false" prefHeight="34.0" prefWidth="62.0" style="-fx-background-color: #999696;" text="Clear" textFill="WHITE">
               <HBox.margin>
                  <Insets left="50.0" />
               </HBox.margin>
               <font>
                  <Font size="13.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <TableView fx:id="reportTableView" layoutX="54.0" layoutY="157.0" prefHeight="302.0" prefWidth="891.0">
        <columns>
          <TableColumn fx:id="dateColumn" prefWidth="297.0" text="Date" />
          <TableColumn fx:id="bookIdColumn" prefWidth="297.0" text="Book_ID" />
            <TableColumn fx:id="studentIdColumn" prefWidth="297.0" text="Student_ID" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
