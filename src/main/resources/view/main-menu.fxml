<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <AnchorPane prefHeight="35.0" style="-fx-background-color: #3f73c1;">
            <Label layoutX="384.0" layoutY="3.0" prefHeight="29.0" prefWidth="232.0" text="Library Management System" textFill="WHITE">
            <font>
               <Font size="18.0" />
            </font></Label>
            <Button fx:id="exitButton" mnemonicParsing="false" style="-fx-background-color: #acabab; -fx-text-fill: black;" text="Exit" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="5.0" />
        </AnchorPane>
    </top>
    <center>
        <TabPane prefWidth="1000.0" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Import Data">
                <fx:include source="import-view.fxml" />
            </Tab>
            <Tab text="Books Issued Report">
                <fx:include source="issued-report.fxml" />
            </Tab>
            <Tab text="Average Book Cost">
                <fx:include source="average-cost.fxml" />
            </Tab>
            <Tab text="Book Search">
                <fx:include source="search-books.fxml" />
            </Tab>
        </TabPane>
    </center>
</BorderPane>
