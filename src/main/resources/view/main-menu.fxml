<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25">
    <top>
        <AnchorPane>
            <Label text="Java Library Viewer" />
            <Label layoutX="318.0" layoutY="-1.0" prefHeight="18.0" prefWidth="164.0" text="Library Management System" />
        </AnchorPane>
    </top>
    <center>
        <TabPane prefWidth="800.0" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Import Data">
                <fx:include source="import-view.fxml" />
            </Tab>
            <Tab text="Books Issued Report">
                <fx:include source="issued-report.fxml" />
            </Tab>
            <Tab text="Average Book Cost">
                <fx:include source="average-cost.fxml" />
            </Tab>
            <Tab text="Book Search">
                <fx:include source="search-books.fxml" />
            </Tab>
        </TabPane>
    </center>
</BorderPane>
